<Window x:Class="AutomationDotNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click Live Desktop Tool (.NET Core Native)" 
        Height="780" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F2C3A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,18,18,24">
            <!-- App Header -->
            <TextBlock Text="Click Live Desktop Tool (.NET Core Native)" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock Text="Mở countdown Chrome → đếm giờ → click trên màn hình desktop" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,16"/>

            <!-- Section 1: Account Queue -->
            <GroupBox Header="TÀI KHOẢN QUEUE">
                <StackPanel>
                    <TextBlock Text="Cùng tài khoản web queue UI — mặc định admin / Admin123@" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/>

                    <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Đang đăng nhập: " VerticalAlignment="Center"/>
                            <Border Background="#1A3A2A" BorderBrush="#2D5A3D" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="TxtLoggedInUser" Text="admin" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <Button x:Name="BtnLogout" Content="Đăng xuất" Width="100" HorizontalAlignment="Left" Click="BtnLogout_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="LoginPanel">
                        <Label Content="URL queue server"/>
                        <TextBox x:Name="TxtQueueUrl" Text="http://160.30.19.215:8787" Margin="0,0,0,8"/>

                        <Label Content="Tên đăng nhập"/>
                        <TextBox x:Name="TxtUsername" Text="admin" Margin="0,0,0,8"/>

                        <Label Content="Mật khẩu"/>
                        <PasswordBox x:Name="TxtPassword" Password="Admin123@" Margin="0,0,0,12"/>

                        <Button x:Name="BtnLogin" Content="Đăng nhập desktop" Style="{StaticResource PrimaryButton}" Click="BtnLogin_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Section 2: Timing & Delay Offset -->
            <GroupBox Header="ĐẾM GIỜ &amp; DELAY ±">
                <StackPanel>
                    <Label Content="Chờ mặc định nếu tin không có TIME (giây)"/>
                    <TextBox x:Name="TxtDefaultWaitSec" Text="0.0" Margin="0,0,0,12" TextChanged="TxtDefaultWaitSec_TextChanged"/>

                    <Label Content="Offset delay (cộng vào TIME trong tin)"/>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="-0.05" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="BtnOffset_Click" Tag="-50"/>
                            <Button Content="-0.01" Style="{StaticResource SmallButton}" Click="BtnOffset_Click" Tag="-10"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="TxtDelayLabel" Text="0.00s" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="+0.01" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="BtnOffset_Click" Tag="10"/>
                            <Button Content="+0.05" Style="{StaticResource SmallButton}" Click="BtnOffset_Click" Tag="50"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Offset dời mốc overlay 0.0s so với TIME trong tin (không phải số overlay lúc click)." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtOffsetExplain" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- Section 3: Click Desktop -->
            <GroupBox Header="CLICK DESKTOP (NGOÀI APP)">
                <StackPanel>
                    <CheckBox x:Name="ChkAutoClick" Content="Tự click sau khi hết giờ" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,0,0,12" Checked="ChkAutoClick_Changed" Unchecked="ChkAutoClick_Changed"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="X (pixel)"/>
                            <TextBox x:Name="TxtClickX" Text="0" TextChanged="TxtClickCoords_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Y (pixel)"/>
                            <TextBox x:Name="TxtClickY" Text="0" TextChanged="TxtClickCoords_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel>
                        <Button x:Name="BtnPickPoint" Content="Chọn điểm trên màn hình" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="BtnPickPoint_Click"/>
                        <Button x:Name="BtnTestClick" Content="Test click" Margin="0,0,8,6" Click="BtnTestClick_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Native Win32 SetCursorPos + mouse_event (nhanh và chính xác cao)." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Section 4: Status -->
            <GroupBox Header="TRẠNG THÁI">
                <StackPanel>
                    <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel x:Name="ClickResultCard" Visibility="Collapsed">
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Vị trí click" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtResultPos" Text="—"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Click thực tế" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtResultClickedAt" Text="—"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Giờ chuẩn" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtResultTarget" Text="—"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lệch giờ chuẩn" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtResultDrift" Text="—" FontWeight="Bold"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Gợi ý offset" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtResultHint" Text="—"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Offset hiện tại" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtResultOffset" Text="—"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Section 5: Log Panel -->
            <GroupBox Header="LOG CLICK / TIMING">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="TxtLogPath" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Mở folder" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="BtnOpenLogFolder_Click"/>
                            <Button Content="Xóa UI" Style="{StaticResource SmallButton}" Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Height="200">
                        <ListBox x:Name="LstLogs" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="11" FontFamily="Consolas, monospace">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss.fff}]'}" Foreground="#64748B" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding EventType, StringFormat='[{0}]'}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
