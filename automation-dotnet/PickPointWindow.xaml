<Window x:Class="AutomationDotNet.PickPointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn vị trí click"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#80000000"
        Topmost="True"
        WindowState="Maximized"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="#17212b" BorderBrush="#3b82f6" BorderThickness="2" CornerRadius="12" Padding="24,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎯 NHẤP CHUỘT VÀO VỊ TRÍ CẦN AUTO-CLICK" 
                           Foreground="#f5f5f5" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Bấm ESC để hủy bỏ" 
                           Foreground="#8b98a8" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
