<Application x:Class="AutomationDotNet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBrush" Color="#0E1621"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#17212B"/>
            <SolidColorBrush x:Key="LineBrush" Color="#2A3544"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#8B98A8"/>
            <SolidColorBrush x:Key="BlueBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="GreenBrush" Color="#22C55E"/>
            <SolidColorBrush x:Key="RedBrush" Color="#F87171"/>
            <SolidColorBrush x:Key="InputBgBrush" Color="#0D1218"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
