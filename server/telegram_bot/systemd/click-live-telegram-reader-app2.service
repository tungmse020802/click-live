[Unit]
Description=Click Live Telegram Client Reader app-2 (Telethon, separate account)
After=network-online.target click-live-queue.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/click-live/server/telegram_bot
EnvironmentFile=/root/click-live/server/telegram_bot/.env.app2
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/click-live/server/telegram_bot/.venv/bin/python /root/click-live/server/telegram_bot/telethon_reader.py
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
