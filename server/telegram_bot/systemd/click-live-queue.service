[Unit]
Description=Click Live Queue UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/click-live/server/telegram_bot
EnvironmentFile=/root/click-live/server/telegram_bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/click-live/server/telegram_bot/.venv/bin/python /root/click-live/server/telegram_bot/queue_ui.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
