[Unit]
Description=Click Live Broadcast Worker (Bot API)
After=network-online.target click-live-queue.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/click-live/server/telegram_bot
EnvironmentFile=/root/click-live/server/telegram_bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/click-live/server/telegram_bot/.venv/bin/python /root/click-live/server/telegram_bot/broadcast_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
