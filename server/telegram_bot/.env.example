TELEGRAM_BOT_TOKEN=
# Bot slots are created from TELEGRAM_BOT_TOKEN / TELEGRAM_BOT_TOKENS (empty slots are removed).
# Assign bots per watch group at /watch UI.
BOT_MODE=polling
BOT_LOG_LEVEL=ERROR
BOT_ALLOWED_USER_IDS=
BOT_REPLY_PREFIX=
BOT_DB_PATH=data/chatbot.sqlite3
BOT_WORKER_ENABLED=true
BOT_QUEUE_ACK=false
BOT_QUEUE_DEFAULT_PRIORITY=100
BOT_QUEUE_LEASE_SECONDS=30
BOT_QUEUE_POLL_INTERVAL_SECONDS=0.1
BOT_QUEUE_MAX_ATTEMPTS=5
BOT_QUEUE_RETRY_DELAY_SECONDS=2
BOT_QUEUE_MAX_ITEMS=1000
BOT_QUEUE_TTL_SECONDS=1800

TELEGRAM_WEB_URL=https://web.telegram.org/k/
TELEGRAM_WEB_PROFILE_DIR=data/telegram_web_profile
TELEGRAM_WEB_HEADLESS=true
TELEGRAM_WEB_TARGETS=""
TELEGRAM_WEB_POLL_INTERVAL_SECONDS=0.2
TELEGRAM_WEB_RELOAD_SECONDS=900
TELEGRAM_WEB_MESSAGE_SCAN_LIMIT=30
TELEGRAM_WEB_QUEUE_MAX_AGE_SECONDS=300
TELEGRAM_WEB_ENQUEUE=true
TELEGRAM_WEB_SKIP_EXISTING_ON_START=false
TELEGRAM_WEB_INCLUDE_OUTGOING=false
TELEGRAM_WEB_FILTER_ENABLED=false
TELEGRAM_WEB_FILTER_CONFIG_PATH=data/message_filters.json
TELEGRAM_WEB_FILTER_RELOAD_SECONDS=1

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CLIENT_SESSION=data/telegram_client.session
TELEGRAM_CLIENT_TARGETS=""     # ví dụ: "Group A|#-3734576353;Group B|@group_username"
TELEGRAM_CLIENT_ENQUEUE=true
TELEGRAM_CLIENT_SKIP_EXISTING_ON_START=true
TELEGRAM_CLIENT_INCLUDE_OUTGOING=false
TELEGRAM_CLIENT_QUEUE_MAX_AGE_SECONDS=300
TELEGRAM_CLIENT_HISTORY_POLL_SECONDS=0.5
TELEGRAM_CLIENT_HISTORY_POLL_LIMIT=20
# Song song handle NewMessage (asyncio), không phải thêm process Telethon cùng session.
TELEGRAM_CLIENT_HANDLE_CONCURRENCY=8
# false = enqueue nhanh; deeplink resolve lazy ở UI/phone/broadcast.
TELEGRAM_CLIENT_ENRICH_DEEPLINK_ON_ENQUEUE=false
# true = mỗi nhóm lắng nghe chỉ giữ 1 tin pending mới nhất (không đụng nhóm khác)
TELEGRAM_CLIENT_QUEUE_ONLY_NEWEST=true
TELEGRAM_CLIENT_SUPERSEDE_PENDING=false
TELEGRAM_CLIENT_FILTER_ENABLED=true
TELEGRAM_CLIENT_FILTER_CONFIG_PATH=data/message_filters.json
TELEGRAM_CLIENT_FILTER_RELOAD_SECONDS=1

BOT_BROADCAST_ENABLED=true
# Parallel workers = logical queues per listening room (fair claim).
BOT_BROADCAST_WORKERS=8
# true = sau khi broadcast tin mới, đánh dấu pending cũ cùng room = done (UI dễ thấy tin “tắt”).
BOT_BROADCAST_SKIP_OLDER_PENDING=true
# Giữ tin pending trên UI bao lâu trước khi thu hồi (supersede). 300 = 5 phút.
BOT_BROADCAST_SKIP_OLDER_AFTER_SECONDS=300

QUEUE_JSON_PATH=data/message_queue.json
QUEUE_JSON_POLL_INTERVAL_SECONDS=0.2
QUEUE_JSON_LIMIT=50
QUEUE_JSON_STATUSES=pending
QUEUE_JSON_PRETTY=false

QUEUE_UI_HOST=127.0.0.1
QUEUE_UI_PORT=8787
QUEUE_UI_LIMIT=100
QUEUE_UI_REFRESH_SECONDS=0.5
QUEUE_UI_USERNAME=admin
QUEUE_UI_PASSWORD=

# admin + admin1..admin10 / Admin123@
QUEUE_UI_USERS=admin:Admin123@,admin1:Admin123@,admin2:Admin123@,admin3:Admin123@,admin4:Admin123@,admin5:Admin123@,admin6:Admin123@,admin7:Admin123@,admin8:Admin123@,admin9:Admin123@,admin10:Admin123@
# Hoặc auto-seed khi để trống QUEUE_UI_USERS:
# QUEUE_UI_SEED_ACCOUNT_COUNT=10
# QUEUE_UI_DEFAULT_PASSWORD=Admin123@
# QUEUE_UI_SEED_PREFIX=admin

# Desktop-tool: mỗi user login trong app (không dùng shared token)
DESKTOP_OPEN_DEDUP_SECONDS=90

# Phone: relay deeplink when Mở link (phone monitor app on LAN, port 8791)
# PHONE_MONITOR_BASE_URL=http://192.168.1.50:8791
# PHONE_OPEN_DEVICE_ID=
# PHONE_OPEN_VIA_ADB=true

# Base URL for /open/live redirect (Telegram clickable link -> snssdk1180 on phone)
# Public URL embedded in forwarded message hyperlinks (use VPS IP/domain, not localhost).
DEEPLINK_OPEN_BASE_URL=http://160.30.19.215:8792
# Internal deeplink resolve API on the same host.
DEEPLINK_API_BASE_URL=http://127.0.0.1:8792
