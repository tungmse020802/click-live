{
  "name": "click-live-desktop-tool",
  "version": "0.1.0",
  "description": "Mở countdown link từ queue UI — mỗi click một tab, tự đóng sau 30s",
  "author": "Click Live",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pull": "cd .. && git pull --ff-only",
    "run": "bash run.sh",
    "dev": "electron .",
    "check": "node --check src/main.js && node --check src/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
