DESKTOP_TOOL_QUEUE_URL=http://160.30.19.215:8787

# Poll queue nhanh hơn (ms). Mặc định 2000 — giảm xuống 500–1000 nếu burst nhiều link
# DESKTOP_TOOL_POLL_MS=800

# Log click/timing (mặc định: desktop-tool/logs khi dev, userData/logs khi cài app)
# DESKTOP_TOOL_LOG_DIR=C:\ClickLive\logs

# Bù độ trễ OS khi click. Để trống = adaptive tự học trên từng máy:
#   - latency click (p95) + hiệu chỉnh drift vs overlay 0.0s, lưu click-lead.json
# Chỉ set cố định khi muốn tắt tự học trên máy đó
# DESKTOP_CLICK_EXECUTION_LEAD_MS=50

# Bỏ click nếu job đến muộn hơn mốc TIME (ms). Mặc định 3000
# DESKTOP_CLICK_MAX_STALE_MS=3000
# Restart PowerShell click helper sau N click (mặc định 120) — tránh click loạn sau chạy lâu
# DESKTOP_CLICK_HELPER_MAX_CLICKS=120
# DESKTOP_CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
