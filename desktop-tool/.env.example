DESKTOP_TOOL_QUEUE_URL=http://160.30.19.215:8787

# Poll queue nhanh hơn (ms). Mặc định 2000 — giảm xuống 500–1000 nếu burst nhiều link
# DESKTOP_TOOL_POLL_MS=800

# Log click/timing (mặc định: desktop-tool/logs khi dev, userData/logs khi cài app)
# DESKTOP_TOOL_LOG_DIR=C:\ClickLive\logs

# Bù độ trễ OS khi click. Để trống = adaptive tự học trên từng máy:
#   - latency click (p90) + ẩn cửa sổ trước click + tự tăng lead khi muộn
# Chỉ set cố định khi muốn tắt tự học trên máy đó
# DESKTOP_CLICK_EXECUTION_LEAD_MS=450
# Percentile latency mẫu (0.9 = bù máy tải cao)
# DESKTOP_CLICK_LATENCY_PERCENTILE=0.9

# Bỏ click nếu job đến muộn hơn mốc TIME (ms). Mặc định 3000
# DESKTOP_CLICK_MAX_STALE_MS=3000
# Windows: double-click mặc định (DESKTOP_CLICK_DOUBLE=false để single click)
# DESKTOP_CLICK_DOUBLE=true
# Delay sau di chuột / giữa down-up / giữa 2 click (ms)
# DESKTOP_CLICK_SETTLE_MS=20
# DESKTOP_CLICK_STEP_MS=12
# DESKTOP_CLICK_DOUBLE_GAP_MS=60
# Windows click mode: deep (mac dinh) | absolute | postmessage | legacy | auto
# deep = focus app dich + SendMessage (HC BOX, app chan SendInput)
# DESKTOP_CLICK_MODE=deep
# DESKTOP_CLICK_DOUBLE=false
# Delay an/hien cua so tool de khong cuop focus (ms)
# DESKTOP_CLICK_FOCUS_MS=80
# DESKTOP_CLICK_RESTORE_MS=200
# DESKTOP_CLICK_HELPER=powershell
# DESKTOP_CLICK_HELPER_WARMUP_PINGS=3
# Ping latency mỗi N ms lúc chạy (mặc định 30000, 0 = tắt)
# DESKTOP_CLICK_HELPER_KEEPALIVE_MS=30000
# Overlay còn bao nhiêu ms lúc chạm chuột (mặc định Windows 80)
# DESKTOP_CLICK_TARGET_OVERLAY_MS=80
# DESKTOP_CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
